@From<"top.mcfpp.mni.minecraft.RandomData">
data Random {
    private id as string;

    constructor(){
        /random reset ${this.id} 0 true true/
    }

    constructor(string){
        this.id = p0;
        /random reset ${this.id} 0 true true/
    }

    constructor(id as string, seed as int, includeWorldSeed as bool, includeGameSeed as bool){
        this.id = id;
        /random reset ${this.id} ${seed} ${includeWorldSeed} ${includeGameSeed}/
    }
}

@From<"top.mcfpp.mni.minecraft.RandomObjectData">
object data Random