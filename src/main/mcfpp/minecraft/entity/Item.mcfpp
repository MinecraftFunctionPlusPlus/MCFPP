@MCFPPEntity
data ItemData: EntityData {
    @Name<"Age">
    var age as short;

    @Name<"Health">
    var health as short;

    @Name<"Item">
    var item as list<ItemData>;

    @Name<"Owner">
    var owner as IntArray;

    @Name<"PickupDelay">
    var pickupDelay as short;

    @Name<"Thrower">
    var thrower as IntArray;
}
