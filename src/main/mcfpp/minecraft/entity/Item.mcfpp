@MCFPPEntity
data ItemData: EntityData {
    @Name<"Age">
    var age: short

    @Name<"Health">
    var health: short

    @Name<"Item">
    var item: list<ItemData>

    @Name<"Owner">
    var owner: IntArray

    @Name<"PickupDelay">
    var pickupDelay: short

    @Name<"Thrower">
    var thrower: IntArray
}
