@MCFPPEntity
data ItemData: EntityData {
    @Name<"Age">
    age as short;

    @Name<"Health">
    health as short;

    @Name<"Item">
    item as list<ItemData>;

    @Name<"Owner">
    owner as IntArray;

    @Name<"PickupDelay">
    pickupDelay as short;

    @Name<"Thrower">
    thrower as IntArray;
}
