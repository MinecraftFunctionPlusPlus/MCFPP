@MCFPPEntity
data TurtleData: EntityData, CreatureData, AIMobData, GrowableData, AnimalData {
    @Name<"HasEgg"> var hasEgg as bool;
    @Name<"HomePosX"> var homePosx as int;
    @Name<"HomePosY"> var homePosy as int;
    @Name<"HomePosZ"> var homePosz as int;
    @Name<"TravelPosX"> var travelPosx as int;
    @Name<"TravelPosY"> var travelPosy as int;
    @Name<"TravelPosZ"> var travelPosz as int;
}
