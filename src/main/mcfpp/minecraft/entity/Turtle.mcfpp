@MCFPPEntity
data Turtle: EntityData, CreatureData, AIMobData, GrowableData, AnimalData {
    @Name<"HasEgg"> hasEgg as bool;
    @Name<"HomePosX"> homePosx as int;
    @Name<"HomePosY"> homePosy as int;
    @Name<"HomePosZ"> homePosz as int;
    @Name<"TravelPosX"> travelPosx as int;
    @Name<"TravelPosY"> travelPosy as int;
    @Name<"TravelPosZ"> travelPosz as int;
}
