import mcfpp.minecraft.std:*;
import mcfpp.minecraft.other:*;

@From<"top.mcfpp.mni.minecraft.EntityTagData">
@From<"top.mcfpp.mni.minecraft.EntityTeamData">
@From<"top.mcfpp.mni.minecraft.EntityEffectData">
@From<"top.mcfpp.mni.minecraft.EntityRideData">
@From<"top.mcfpp.mni.minecraft.PlayerXpData">
@From<"top.mcfpp.mni.minecraft.PlayerAdvancementData">
@From<"top.mcfpp.mni.minecraft.PlayerStateData">
@From<"top.mcfpp.mni.minecraft.EntityTeleportData">
@From<"top.mcfpp.mni.minecraft.PlayerMessageData">
@From<"top.mcfpp.mni.minecraft.EntityAttributeData">
data EntityData {
    @Name<"Air">
    var air as short;

    @Name<"CustomName">
    var customName as string;

    @Name<"CustomNameVisible">
    var customNameVisible as bool;

    @Name<"FallDistance", "1.21.5">
    @Name<"fall_distance">
    var fallDistance as float;

    @Name<"Fire">
    var fire as short;

    @Name<"Glowing">
    var glowing as bool;

    @Name<"HasVisualFire">
    var hasVisualFire as bool;

    @Name<"Invulnerable">
    var invulnerable as bool;

    @Name<"Motion">
    var motion as list<double>;

    @Name<"NoGravity">
    var noGravity as bool;

    @Name<"onGround">
    var onGround as bool;

    @Name<"Passengers">
    var passengers as list<EntityData>;

    @Name<"PortalCooldown">
    var portalCooldown as int;

    @Name<"Pos">
    var pos as list<double>;

    @Name<"Rotation">
    var rotation as list<float>;

    @Name<"Silent">
    var silent as bool;

    @Name<"Tags">
    var tags as list<string>;

    @Name<"TicksFrozen">
    var ticksFrozen as int;

    @Name<"UUID">
    var uuid as IntArray;
}
