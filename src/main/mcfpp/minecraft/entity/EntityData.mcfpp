data EntityData {
    @Name<"Air">
    air as short;

    @Name<"CustomName">
    customName as string;

    @Name<"CustomNameVisible">
    customNameVisible as bool;

    @Name<"FallDistance", "1.21.5">
    @Name<"fall_distance">
    fallDistance as float;

    @Name<"Fire">
    fire as short;

    @Name<"Glowing">
    glowing as bool;

    @Name<"HasVisualFire">
    hasVisualFire as bool;

    @Name<"Invulnerable">
    invulnerable as bool;

    @Name<"Motion">
    motion as list<double>;

    @Name<"NoGravity">
    noGravity as bool;

    @Name<"onGround">
    onGround as bool;

    @Name<"Passengers">
    passengers as list<EntityData>;

    @Name<"PortalCooldown">
    portalCooldown as int;

    @Name<"Pos">
    pos as list<double>;

    @Name<"Rotation">
    rotation as list<float>;

    @Name<"Silent">
    silent as bool;

    @Name<"Tags">
    tags as list<string>;

    @Name<"TicksFrozen">
    ticksFrozen as int;

    @Name<"UUID">
    uuid as IntArray;
}