@MCFPPEntity
data ZombieVillagerData: EntityData, CreatureData, AIMobData, GeneralZombieData {
    @Name<"ConversionTime"> conversionTime as int;
    @Name<"ConversionPlayer"> conversionPlayer as IntArray;

    @Name<"Offers"> offers as data {
        @Name<"Recipes"> recipes as list<VillagerRecipe>;
    };

    @Name<"Gossips"> gossips as list<VillagerGossip>;

    @Name<"VillagerData"> villagerData as data {
        level as int;
        profession as string;
        type as string;
    };

    @Name<"Xp"> xp as int;
}
