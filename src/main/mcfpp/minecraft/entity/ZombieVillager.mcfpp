@MCFPPEntity
data ZombieVillagerData: EntityData, CreatureData, AIMobData, GeneralZombieData {
    @Name<"ConversionTime"> var conversionTime as int;
    @Name<"ConversionPlayer"> var conversionPlayer as IntArray;

    @Name<"Offers"> var offers as data {
        @Name<"Recipes"> var recipes as list<VillagerRecipe>;
    };

    @Name<"Gossips"> var gossips as list<VillagerGossip>;

    @Name<"VillagerData"> var villagerData as data {
        var level as int;
        var profession as string;
        var type as string;
    };

    @Name<"Xp"> var xp as int;
}
