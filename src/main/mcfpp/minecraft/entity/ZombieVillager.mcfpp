@MCFPPEntity
data ZombieVillagerData: EntityData, CreatureData, AIMobData, GeneralZombieData {
    @Name("ConversionTime") var conversionTime: int
    @Name("ConversionPlayer") var conversionPlayer: IntArray

    @Name("Offers") var offers: data {
        @Name("Recipes") var recipes: list<VillagerRecipe>
    }

    @Name("Gossips") var gossips: list<VillagerGossip>

    @Name("VillagerData") var villagerData: data {
        var level: int
        var profession: string
        var type: string
    }

    @Name("Xp") var xp: int
}
