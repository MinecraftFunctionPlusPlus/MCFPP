import mcfpp.minecraft.item:ItemStackData;

@MCFPPEntity
data ArmorStandData: EntityData, CreatureData {

    @Name<"ArmorItems">
    var armorItems as list<ItemData>;

    @Name<"DisabledSlots">
    var disabledslots as int;

    @Name<"HandItems">
    var handItems as list<ItemData>;

    @Name<"Invisible">
    var invisible as bool;

    @Name<"Marker">
    var marker as bool;

    @Name<"NoBasePlate">
    var noBasePlate as bool;

    @Name<"Pose">
    var pose as data {
        @Name<"Body">
        var body as list<float>;

        @Name<"Head">
        var head as list<float>;

        @Name<"LeftArm">
        var leftArm as list<float>;

        @Name<"LeftLeg">
        var leftLeg as list<float>;

        @Name<"RightArm">
        var rightArm as list<float>;

        @Name<"RightLeg">
        var rightLeg as list<float>;
    };

    @Name<"ShowArms">
    var showArms as bool;

    @Name<"Small">
    var small as bool;
}
