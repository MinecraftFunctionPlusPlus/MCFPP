import mcfpp.minecraft.item:ItemStackData;

@MCFPPEntity
data ArmorStandData: EntityData, CreatureData {

    @Name<"ArmorItems">
    armorItems as list<ItemData>;

    @Name<"DisabledSlots">
    disabledslots as int;

    @Name<"HandItems">
    handItems as list<ItemData>;

    @Name<"Invisible">
    invisible as bool;

    @Name<"Marker">
    marker as bool;

    @Name<"NoBasePlate">
    noBasePlate as bool;

    @Name<"Pose">
    pose as data {
        @Name<"Body">
        body as list<float>;

        @Name<"Head">
        head as list<float>;

        @Name<"LeftArm">
        leftArm as list<float>;

        @Name<"LeftLeg">
        leftLeg as list<float>;

        @Name<"RightArm">
        rightArm as list<float>;

        @Name<"RightLeg">
        rightLeg as list<float>;
    };

    @Name<"ShowArms">
    showArms as bool;

    @Name<"Small">
    small as bool;
}