import mcfpp.minecraft.item:ItemStackData

@MCFPPEntity
data ArmorStandData: EntityData, CreatureData {

    @Name<"ArmorItems">
    var armorItems: list<ItemData>

    @Name<"DisabledSlots">
    var disabledslots: int

    @Name<"HandItems">
    var handItems: list<ItemData>

    @Name<"Invisible">
    var invisible: bool

    @Name<"Marker">
    var marker: bool

    @Name<"NoBasePlate">
    var noBasePlate: bool

    @Name<"Pose">
    var pose: data {
        @Name<"Body">
        var body: list<float>

        @Name<"Head">
        var head: list<float>

        @Name<"LeftArm">
        var leftArm: list<float>

        @Name<"LeftLeg">
        var leftLeg: list<float>

        @Name<"RightArm">
        var rightArm: list<float>

        @Name<"RightLeg">
        var rightLeg: list<float>
    }

    @Name<"ShowArms">
    var showArms: bool

    @Name<"Small">
    var small: bool
}
