@MCFPPEntity
data LlamaData: EntityData, CreatureData, AIMobData, GrowableData, AnimalData, GeneralHorseData {
    @Name<"ChestedHorse"> var chestedHorse as bool;
    @Name<"Items"> var items as list<ItemData>;
    @Name<"Strength"> var strength as int;
    @Name<"Variant"> var variant as LlamaVariant;
}


enum LlamaVariant {
    creamy = 0,
    white = 1,
    brown = 2,
    gray = 3
}
