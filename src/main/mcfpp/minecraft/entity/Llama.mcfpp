@MCFPPEntity
data Llama: EntityData, CreatureData, AIMobData, GrowableData, AnimalData, HorseData {
    @Name<"ChestedHorse"> chestedHorse as bool;
    @Name<"Items"> items as list<Item>;
    @Name<"Strength"> strength as int;
    @Name<"Variant"> variant as LlamaVariant;
}


enum LlamaVariant {
    creamy = 0,
    white = 1,
    brown = 2,
    gray = 3
}