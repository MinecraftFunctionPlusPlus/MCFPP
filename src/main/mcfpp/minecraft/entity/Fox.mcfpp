@MCFPPEntity
data FoxData : EntityData, CreatureData, AIMobData, GrowableData, AnimalData {
    @Name("Crouching")
    var crouching: bool

    @Name("Sitting")
    var sitting: bool

    @Name("Sleeping")
    var sleeping: bool

    @Name("Trusted")
    var trusted: list<IntArray>

    @Name("Type")
    var type: FoxType
}

enum FoxType {
    red, snow
}
