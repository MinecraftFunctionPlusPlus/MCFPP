@MCFPPEntity
data FoxData : EntityData, CreatureData, AIMobData, GrowableData, AnimalData {
    @Name<"Crouching">
    crouching as bool;

    @Name<"Sitting">
    sitting as bool;

    @Name<"Sleeping">
    sleeping as bool;

    @Name<"Trusted">
    trusted as list<IntArray>;

    @Name<"Type">
    type as FoxType;
}

enum FoxType {
    red, snow
}