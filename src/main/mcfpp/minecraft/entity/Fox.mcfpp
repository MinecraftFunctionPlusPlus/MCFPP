@MCFPPEntity
data FoxData : EntityData, CreatureData, AIMobData, GrowableData, AnimalData {
    @Name<"Crouching">
    var crouching as bool;

    @Name<"Sitting">
    var sitting as bool;

    @Name<"Sleeping">
    var sleeping as bool;

    @Name<"Trusted">
    var trusted as list<IntArray>;

    @Name<"Type">
    var type as FoxType;
}

enum FoxType {
    red, snow
}
