@MCFPPEntity
data DolphinData: EntityData, CreatureData, AIMobData, GrowableData {
    @Name<"Moistness">
    var moistness as int;

    @Name<"GotFish">
    var gotFish as byte;

    @Name<"TreasurePosX">
    var treasurePosX as int;

    @Name<"TreasurePosY">
    var treasurePosY as int;

    @Name<"TreasurePosZ">
    var treasurePosZ as int;
}
