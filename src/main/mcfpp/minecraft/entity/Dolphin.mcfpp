@MCFPPEntity
data Dolphin: EntityData, CreatureData, AIMobData, GrowableData {
    @Name<"Moistness">
    moistness as int;

    @Name<"GotFish">
    gotFish as byte;

    @Name<"TreasurePosX">
    treasurePosX as int;

    @Name<"TreasurePosY">
    treasurePosY as int;

    @Name<"TreasurePosZ">
    treasurePosZ as int;
}