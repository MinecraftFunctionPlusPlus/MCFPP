import mcfpp.minecraft.item:ItemStackData;

@MCFPPEntity
data FireworkRocketData {
    @Name<"FireworksItem">
    var fireworksItem as list<ItemStackData>;

    @Name<"Life">
    var life as int;

    @Name<"LifeTime">
    var lifeTime as int;

    @Name<"ShotAtAngle">
    var shotAtAngle as byte;
}
