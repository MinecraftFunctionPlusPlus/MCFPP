import mcfpp.minecraft.item:ItemStackData;
import mcfpp.minecraft.other:BlockState;

@MCFPPEntity
data GeneralArrowData{
    var crit as bool;

    var damage as double;

    var inBlockState as BlockState;

    var inGround as bool;

    var item as ItemData;

    var life as short;

    var pickup as byte;

    @Name<"PierceLevel">
    var pierceLevel as byte;

    var shake as byte;

    @Name<"SoundEvent">
    var soundEvent as string;

    var weapon as ItemData;
}

data ArrowData: EntityData, ProjectileData, GeneralArrowData;
