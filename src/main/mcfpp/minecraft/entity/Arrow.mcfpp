import mcfpp.minecraft.item:ItemStackData
import mcfpp.minecraft.other:BlockState

@MCFPPEntity
data GeneralArrowData{
    var crit: bool

    var damage: double

    var inBlockState: BlockState

    var inGround: bool

    var item: ItemData

    var life: short

    var pickup: byte

    @Name<"PierceLevel">
    var pierceLevel: byte

    var shake: byte

    @Name<"SoundEvent">
    var soundEvent: string

    var weapon: ItemData
}

data ArrowData: EntityData, ProjectileData, GeneralArrowData
