import mcfpp.minecraft.item:ItemStackData;

@MCFPPEntity
data AllayData: EntityData, AIMobData, CreatureData {
    @Name<"CanDuplicate">
    canDuplicate as byte;

    @Name<"DuplicationCooldown">
    duplicationCooldown as long;

    @Name<"Inventory">
    inventory as list<ItemStackData>;

    @Name<"Listener">
    listener as Listener;
}

data Listener {
    event as data {
        distance as float;
        @Name<"game_event">
        gameEvent as string;
        
        pos as list<double>;
        
        @Name<"projectile_owner">
        projectileOwner as IntArray;
        source as IntArray;
    };
    @Name<"event_delay">
    eventDelay as int;
    @Name<"selector">
    _selector as data {
        tick as long;
        event as data {
            distance as float;
            @Name<"game_event">
            gameEvent as string;
            pos as list<double>;
            @Name<"projectile_owner">
            projectileOwner as IntArray;
            source as IntArray;
        };
    };
}