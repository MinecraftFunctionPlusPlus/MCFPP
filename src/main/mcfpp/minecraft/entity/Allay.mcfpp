import mcfpp.minecraft.item:ItemStackData

@MCFPPEntity
data AllayData: EntityData, AIMobData, CreatureData {
    @Name("CanDuplicate")
    var canDuplicate: byte

    @Name("DuplicationCooldown")
    var duplicationCooldown: long

    @Name("Inventory")
    var inventory: list<ItemStackData>

    @Name("Listener")
    var listener: Listener
}

data Listener {
    var event: data {
        var distance: float
        @Name("game_event")
        var gameEvent: string
        
        var pos: list<double>
        
        @Name("projectile_owner")
        var projectileOwner: IntArray
        var source: IntArray
    }
    @Name("event_delay")
    var eventDelay: int
    @Name("selector")
    var _selector: data {
        var tick: long
        var event: data {
            var distance: float
            @Name("game_event")
            var gameEvent: string
            var pos: list<double>
            @Name("projectile_owner")
            var projectileOwner: IntArray
            var source: IntArray
        }
    }
}
