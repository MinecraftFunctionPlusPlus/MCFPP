import mcfpp.minecraft.item:ItemStackData;

@MCFPPEntity
data AllayData: EntityData, AIMobData, CreatureData {
    @Name<"CanDuplicate">
    var canDuplicate as byte;

    @Name<"DuplicationCooldown">
    var duplicationCooldown as long;

    @Name<"Inventory">
    var inventory as list<ItemStackData>;

    @Name<"Listener">
    var listener as Listener;
}

data Listener {
    var event as data {
        var distance as float;
        @Name<"game_event">
        var gameEvent as string;
        
        var pos as list<double>;
        
        @Name<"projectile_owner">
        var projectileOwner as IntArray;
        var source as IntArray;
    };
    @Name<"event_delay">
    var eventDelay as int;
    @Name<"selector">
    var _selector as data {
        var tick as long;
        var event as data {
            var distance as float;
            @Name<"game_event">
            var gameEvent as string;
            var pos as list<double>;
            @Name<"projectile_owner">
            var projectileOwner as IntArray;
            var source as IntArray;
        };
    };
}
