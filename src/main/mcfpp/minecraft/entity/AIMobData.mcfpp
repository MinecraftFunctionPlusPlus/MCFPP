data AIMobData {
    @Name<"ArmorDropChances">
    armorDropChances as list<float>;

    @Name<"ArmorItems">
    armorItems as list<Item>;

    @Name<"body_armor_drop_chance">
    bodyArmorDropChance as float;

    @Name<"body_armor_item">
    bodyArmorItem as list<Item>;

    @Name<"CanPickUpLoot">
    canPickUpLoot as bool;

    @Name<"DeathLootTable">
    deathLootTable as list<AIMobData>;

    @Name<"DeathLootTableSeed">
    deathLootTableSeed as long;

    @Name<"HandDropChances">
    handDropChances as list<float>;

    @Name<"HandItems">
    handItems as list<Item>;

    @Name<"leash">
    leash as (IntArray|nbt);

    @Name<"LeftHanded">
    leftHanded as bool;

    @Name<"NoAI">
    noAI as bool;

    @Name<"PersistenceRequired">
    persistenceRequired as bool;
}