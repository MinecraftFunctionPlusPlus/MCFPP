import mcfpp.minecraft.item:ItemStackData;

data AIMobData {
    @Name<"ArmorDropChances">
    var armorDropChances as list<float>;

    @Name<"ArmorItems">
    var armorItems as list<ItemData>;

    @Name<"body_armor_drop_chance">
    var bodyArmorDropChance as float;

    @Name<"body_armor_item">
    var bodyArmorItem as list<ItemData>;

    @Name<"CanPickUpLoot">
    var canPickUpLoot as bool;

    @Name<"DeathLootTable">
    var deathLootTable as list<AIMobData>;

    @Name<"DeathLootTableSeed">
    var deathLootTableSeed as long;

    @Name<"HandDropChances">
    var handDropChances as list<float>;

    @Name<"HandItems">
    var handItems as list<ItemData>;

    @Name<"leash">
    var leash as (IntArray|nbt);

    @Name<"LeftHanded">
    var leftHanded as bool;

    @Name<"NoAI">
    var noAI as bool;

    @Name<"PersistenceRequired">
    var persistenceRequired as bool;
}
