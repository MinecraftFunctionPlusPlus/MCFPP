@MCFPPEntity
data WanderingTraderData: EntityData, CreatureData, AIMobData, GrowableData {
    @Name<"DespawnDelay"> despawnDelay as int;
    @Name<"Offers"> offers as data {
        @Name<"Recipes"> recipes as list<VillagerRecipe>;
    };
    @Name<"Inventory"> inventory as list<ItemData>;
    @Name<"wander_target"> wanderTarget as IntArray;
}
