@MCFPPEntity
data WanderingTraderData: EntityData, CreatureData, AIMobData, GrowableData {
    @Name<"DespawnDelay"> var despawnDelay as int;
    @Name<"Offers"> var offers as data {
        @Name<"Recipes"> var recipes as list<VillagerRecipe>;
    };
    @Name<"Inventory"> var inventory as list<ItemData>;
    @Name<"wander_target"> var wanderTarget as IntArray;
}
