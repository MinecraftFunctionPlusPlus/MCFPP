@MCFPPEntity
data Piglin: EntityData, CreatureData, AIMobData, AnimalData {
    @Name<"CannotHunt">
    cannotHunt as bool;

    @Name<"Inventory">
    inventory as list<Item>;

    @Name<"IsBaby">
    isBaby as bool;

    @Name<"IsImmuneToZombification">
    isImmuneToZombification as bool;

    @Name<"TimeInOverworld">
    timeInOverworld as int;
}
