@MCFPPEntity
data PiglinData: EntityData, CreatureData, AIMobData, AnimalData {
    @Name<"CannotHunt">
    var cannotHunt as bool;

    @Name<"Inventory">
    var inventory as list<ItemData>;

    @Name<"IsBaby">
    var isBaby as bool;

    @Name<"IsImmuneToZombification">
    var isImmuneToZombification as bool;

    @Name<"TimeInOverworld">
    var timeInOverworld as int;
}
