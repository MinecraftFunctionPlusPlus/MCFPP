@MCFPPEntity
data PiglinData: EntityData, CreatureData, AIMobData, AnimalData {
    @Name("CannotHunt")
    var cannotHunt: bool

    @Name("Inventory")
    var inventory: list<ItemData>

    @Name("IsBaby")
    var isBaby: bool

    @Name("IsImmuneToZombification")
    var isImmuneToZombification: bool

    @Name("TimeInOverworld")
    var timeInOverworld: int
}
