@MCFPPEntity
data Bee: EntityData, CreatureData, AIMobData, GrowableData, AnimalData, NeutralData {
    @Name<"CannotEnterHiveTicks">
    cannotEnterHiveTicks as int;

    @Name<"CropsGrownSincePollination">
    cropsGrownSincePollination as int;

    @Name<"flower_pos">
    flowerPos as IntArray;

    @Name<"HasNectar">
    hasNectar as byte;

    @Name<"HasStung">
    hasStung as byte;

    @Name<"hive_pos">
    hivePos as IntArray;

    @Name<"TicksSincePollination">
    ticksSincePollination as int;
}