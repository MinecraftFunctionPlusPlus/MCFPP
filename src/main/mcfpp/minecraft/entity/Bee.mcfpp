@MCFPPEntity
data BeeData: EntityData, CreatureData, AIMobData, GrowableData, AnimalData, NeutralData {
    @Name<"CannotEnterHiveTicks">
    var cannotEnterHiveTicks as int;

    @Name<"CropsGrownSincePollination">
    var cropsGrownSincePollination as int;

    @Name<"flower_pos">
    var flowerPos as IntArray;

    @Name<"HasNectar">
    var hasNectar as byte;

    @Name<"HasStung">
    var hasStung as byte;

    @Name<"hive_pos">
    var hivePos as IntArray;

    @Name<"TicksSincePollination">
    var ticksSincePollination as int;
}
