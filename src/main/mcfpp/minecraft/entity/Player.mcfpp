import mcfpp.minecraft.other:*;
import mcfpp.minecraft.item:ItemStackData;

@MCFPPEntity
data PlayerData: EntityData, CreatureData {
    @Name<"DataVersion"> dataVersion as int;
    @Name<"Abilities"> abilities as data {
        @Name<"Flying"> flying as bool;
        @Name<"FlySpeed"> flySpeed as float;
        @Name<"Instabuild"> instabuild as bool;
        @Name<"Invulnerable"> invulnerable as bool;
        @Name<"MayBuild"> mayBuild as bool;
        @Name<"MayFly"> mayFly as bool;
        @Name<"WalkSpeed"> walkSpeed as float;
    };
    @Name<"current_explosion_impact_pos"> currentExplosionImpactPos as list<double>;
    @Name<"current_impulse_context_reset_grace_time"> currentImpulseContextResetGraceTime as int;
    @Name<"Dimension"> dimension as string;
    @Name<"ender_pearls"> enderPearls as list<data: EnderPearlData {
        @Name<"ender_pearl_dimension"> enderPearlDimension as string;
    }>;
    @Name<"EnderItems"> enderItems as list<ItemData>;
    enteredNetherPosition as list<double>;
    foodExhaustionLevel as float;
    foodLevel as int;
    foodSaturationLevel as float;
    foodTickTimer as int;
    @Name<"ignore_fall_damage_from_current_explosion"> ignoreFallDamageFromCurrentExplosion as bool;
    @Name<"Inventory"> inventory as list<ItemData>;
    @Name<"LastDeathLocation"> lastDeathLocation as data {
        dimension as string;
        pos as IntArray;
    };
    playerGameType as int;
    previousplayerGameType as int;
    @Name<"raid_omen_position"> raidOmenPosition as IntArray;
    @Name<"RecipeBook"> recipeBook as list<RecipeBook>;
    @Name<"RootVehicle"> rootVehicle as data {
        @Name<"Attach"> attach as IntArray;
        @Name<"Entity"> _entity as EntityData;
    };
    @Name<"Score"> score as int;
    seenCredits as byte;
    @Name<"SelectedItem"> selectedItem as ItemStackData;
    @Name<"SelectedItemSlot"> selectedItemSlot as int;
    @Name<"ShoulderEntityLeft"> shoulderEntityLeft as EntityData;
    @Name<"ShoulderEntityRight"> shoulderEntityRight as EntityData;
    @Name<"SleepTimer"> sleepTimer as short;
    @Name<"spawn_extra_particles_on_fall"> spawnExtraParticlesOnFall as bool;
    @Name<"SpawnAngle"> spawnAngle as float;
    @Name<"SpawnDimension"> spawnDimension as string;
    @Name<"SpawnForced"> spawnForced as bool;
    @Name<"SpawnX"> spawnX as int;
    @Name<"SpawnY"> spawnY as int;
    @Name<"SpawnZ"> spawnZ as int;
    @Name<"warden_spawn_tracker"> wardenSpawnTracker as data {
        @Name<"cooldown_ticks"> cooldownTicks as int;
        @Name<"ticks_since_last_warning"> ticksSinceLastWarning as int;
        @Name<"warning_level"> warningLevel as int;
    };
    @Name<"XpLevel"> xpLevel as int;
    @Name<"XpP"> xpP as float;
    @Name<"XpSeed"> xpSeed as int;
    @Name<"XpTotal"> xpTotal as int;
}
