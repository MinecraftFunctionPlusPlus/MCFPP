namespace mcfpp.minecraft.entity

/// 可复用的实体生成模板。initialNBT 是生成配置，entity var 保存于每个实体自身。
abstract entity Entity {
    var initialNBT: nbt = {}
    constructor(n: nbt = {}) { this.initialNBT = n }
}

abstract entity DisplayEntity: Entity {
    constructor(n: nbt = {}) { this.initialNBT = n }
}

