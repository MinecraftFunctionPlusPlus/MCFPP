import mcfpp.minecraft.other:*;
data CreatureData{
    @Name<"AbsorptionAmount">
    absorptionAmount as float;

    @Name<"active_effects">
    activeEffects as list<PotionEffect>;

    attributes as list<Attribute>;

    @Name<"Brain">
    brain as nbt;

    @Name<"DeathTime">
    deathTime as short;

    @Name<"FallFlying">
    fallFlying as bool;

    @Name<"Health">
    health as float;

    @Name<"HurtByTimestamp">
    hurtByTimestamp as int;

    @Name<"HurtTime">
    hurtTime as short;

    @Name<"SleepingX">
    sleepingX as int;

    @Name<"SleepingY">
    sleepingY as int;

    @Name<"SleepingZ">
    sleepingZ as int;

    @Name<"Team">
    team as string;
}