import mcfpp.minecraft.other:*;
data CreatureData{
    @Name<"AbsorptionAmount">
    var absorptionAmount as float;

    @Name<"active_effects">
    var activeEffects as list<PotionEffectData>;

    var attributes as list<Attribute>;

    @Name<"Brain">
    var brain as nbt;

    @Name<"DeathTime">
    var deathTime as short;

    @Name<"FallFlying">
    var fallFlying as bool;

    @Name<"Health">
    var health as float;

    @Name<"HurtByTimestamp">
    var hurtByTimestamp as int;

    @Name<"HurtTime">
    var hurtTime as short;

    @Name<"SleepingX">
    var sleepingX as int;

    @Name<"SleepingY">
    var sleepingY as int;

    @Name<"SleepingZ">
    var sleepingZ as int;

    @Name<"Team">
    var team as string;
}
