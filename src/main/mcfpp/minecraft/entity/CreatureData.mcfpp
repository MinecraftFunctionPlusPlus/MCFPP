import mcfpp.minecraft.other:*
data CreatureData{
    @Name<"AbsorptionAmount">
    var absorptionAmount: float

    @Name<"active_effects">
    var activeEffects: list<PotionEffectData>

    var attributes: list<Attribute>

    @Name<"Brain">
    var brain: nbt

    @Name<"DeathTime">
    var deathTime: short

    @Name<"FallFlying">
    var fallFlying: bool

    @Name<"Health">
    var health: float

    @Name<"HurtByTimestamp">
    var hurtByTimestamp: int

    @Name<"HurtTime">
    var hurtTime: short

    @Name<"SleepingX">
    var sleepingX: int

    @Name<"SleepingY">
    var sleepingY: int

    @Name<"SleepingZ">
    var sleepingZ: int

    @Name<"Team">
    var team: string
}
