@MCFPPEntity
data GeneralHorseData {
    @Name<"Bred">
    var bred: bool

    @Name<"EatingHaystack">
    var eatingHaystack: bool

    @Name<"Owner">
    var owner: IntArray

    @Name<"SaddleItem">
    var saddleItem: ItemData

    @Name<"Tame">
    var tame: bool

    @Name<"Temper">
    var temper: int
}
