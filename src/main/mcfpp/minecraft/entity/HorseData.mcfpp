@MCFPPEntity
data GeneralHorseData {
    @Name<"Bred">
    var bred as bool;

    @Name<"EatingHaystack">
    var eatingHaystack as bool;

    @Name<"Owner">
    var owner as IntArray;

    @Name<"SaddleItem">
    var saddleItem as ItemData;

    @Name<"Tame">
    var tame as bool;

    @Name<"Temper">
    var temper as int;
}
