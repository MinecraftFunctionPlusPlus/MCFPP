@MCFPPEntity
data GeneralHorseData {
    @Name<"Bred">
    bred as bool;

    @Name<"EatingHaystack">
    eatingHaystack as bool;

    @Name<"Owner">
    owner as IntArray;

    @Name<"SaddleItem">
    saddleItem as ItemData;

    @Name<"Tame">
    tame as bool;

    @Name<"Temper">
    temper as int;
}
