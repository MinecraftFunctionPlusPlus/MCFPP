@MCFPPEntity
data VillagerData: EntityData, CreatureData, AIMobData, GrowableData {
    @Name<"AssignProfessionWhenSpawned"> var assignProfessionWhenSpawned as bool;
    @Name<"FoodLevel"> var foodLevel as byte;
    @Name<"Inventory"> var inventory as list<ItemData>;
    @Name<"Gossips"> var gossips as list<VillagerGossip>;
    @Name<"LastRestock"> var lastRestock as long;
    @Name<"LastGossipDecay"> var lastGossipDecay as long;

    @Name<"Offers"> var offers as data {
        @Name<"Recipes"> var recipes as list<VillagerRecipe>;
    };

    @Name<"RestocksToday"> var restocksToday as int;

    @Name<"VillagerData"> var villagerData as data {
        var level as int;
        var profession as string;
        var type as string;
    };

    @Name<"Xp"> var xp as int;
}

enum GossipType {
    major_negative,
    minor_negative,
    major_positive,
    minor_positive,
    trading
}

data VillagerGossip {
    var target as IntArray;
    var type as GossipType;
    var value as int;
}

data VillagerRecipe {
    var buy as data {
        var id as string;
        var components as nbt;
    };
    var buyB as data {
        var id as string;
        var components as nbt;
    };
    var demand as int;
    var maxUses as int;
    var priceMultiplier as float;
    var rewardExp as bool;
    var sell as ItemData;
    var specialPrice as int;
    var uses as int;
    var xp as int;
}
