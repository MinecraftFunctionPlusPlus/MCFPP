@MCFPPEntity
data VillagerData: EntityData, CreatureData, AIMobData, GrowableData {
    @Name<"AssignProfessionWhenSpawned"> assignProfessionWhenSpawned as bool;
    @Name<"FoodLevel"> foodLevel as byte;
    @Name<"Inventory"> inventory as list<ItemData>;
    @Name<"Gossips"> gossips as list<VillagerGossip>;
    @Name<"LastRestock"> lastRestock as long;
    @Name<"LastGossipDecay"> lastGossipDecay as long;

    @Name<"Offers"> offers as data {
        @Name<"Recipes"> recipes as list<VillagerRecipe>;
    };

    @Name<"RestocksToday"> restocksToday as int;

    @Name<"VillagerData"> villagerData as data {
        level as int;
        profession as string;
        type as string;
    };

    @Name<"Xp"> xp as int;
}

enum GossipType {
    major_negative,
    minor_negative,
    major_positive,
    minor_positive,
    trading
}

data VillagerGossip {
    target as IntArray;
    type as GossipType;
    value as int;
}

data VillagerRecipe {
    buy as data {
        id as string;
        components as nbt;
    };
    buyB as data {
        id as string;
        components as nbt;
    };
    demand as int;
    maxUses as int;
    priceMultiplier as float;
    rewardExp as bool;
    sell as ItemData;
    specialPrice as int;
    uses as int;
    xp as int;
}
