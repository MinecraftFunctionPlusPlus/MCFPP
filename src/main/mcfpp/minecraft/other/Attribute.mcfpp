data Attribute {
    var id as string;
    var base as double;
    var modifiers as list<AttributeModifier>;
}

data AttributeModifier {
    var type as AttributeModifierType;
    var amount as double;
    var id as string;
}

enum AttributeModifierType {
    add_value,
    add_multiplied_base,
    add_multiplied_total
}
