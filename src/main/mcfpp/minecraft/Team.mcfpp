import mcfpp.minecraft.std:*

@From("top.mcfpp.mni.minecraft.TeamData")
data Team {
    var id: string
    var displayName: text

    constructor(id: string){
        this.id = id
        this.displayName = id
    }

    constructor(id: string, displayName: text){
        this.id = id
        this.displayName = displayName
    }
}

enum NametagVisibility {
    never,
    hideForOtherTeams,
    hideForOwnTeam,
    always
}

enum DeathMessageVisibility {
    never,
    hideForOtherTeams,
    hideForOwnTeam,
    always
}

enum CollisionRule {
    pushOtherTeams,
    pushOwnTeam,
    always,
    never
}
