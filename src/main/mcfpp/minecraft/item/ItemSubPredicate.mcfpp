import mcfpp.math:*

data ItemSubPredicate

data AttributeModifierPredicate: ItemSubPredicate {
    var modifiers: AttributeModifiers
}

data AttributeModifiers {
    var contains: list<AttributePredicate>?
    var size: (int | IntRange)?
    var count: list<AttributeCountPredicate>?
}

data AttributeCountPredicate {
    var test: AttributePredicate
    var count: (int | IntRange)
}

data AttributePredicate {
    var attribute: (string | list<string>)?
    var id: list<string>?
    var amount: (float | DecimalRange)?
    var operation: AttributeOperation?
    var slot: AttributeSlot?
}

enum AttributeOperation {
    ADD_VALUE = "add_value",
    ADD_MULTIPLIED_BASE = "add_multiplied_base",
    ADD_MULTIPLIED_TOTAL = "add_multiplied_total"
}

enum AttributeSlot {
    ANY = "any",
    MAINHAND = "mainhand",
    OFFHAND = "offhand",
    HAND = "hand",
    HEAD = "head",
    CHEST = "chest",
    LEGS = "legs",
    FEET = "feet",
    ARMOR = "armor"
}

data BundleContentsPredicate: ItemSubPredicate {
    var items: ItemStackCompoundPredicate
}

data ContainerPredicate: ItemSubPredicate {
    var items: ItemStackCompoundPredicate
}

data ItemStackCompoundPredicate {
    var contains: list<ItemStackPredicate>
    var size: (int | IntRange)?
    var count: list<ItemStackCountPredicate>?
}

data ItemStackPredicate {
    var components: dict<ItemComponent>?
    var count: (int | IntRange)?
    var items: (string | list<string>)?
    var predicates: dict<nbt>?
}

data ItemStackCountPredicate {
    var test: ItemStackPredicate
    var count: (int | IntRange)
}

data CustomDataPredicate {}

data DamagePredicate: ItemSubPredicate {
    var damage: (int | IntRange)?
    var durability: (int | IntRange)?
}

data EnchantmentPredicate: ItemSubPredicate {
    var enchantments: (string | list<string>)
    var levels: (int | IntRange)
}

data FireworkExplosionPredicate: ItemSubPredicate {
    var shape: FireworkShape?
    var hasTrail: bool?
    var hasTwinkle: bool?
}

enum FireworkShape {
    SMALL_BALL = "small_ball",
    LARGE_BALL = "large_ball",
    STAR = "star",
    CREEPER = "creeper",
    BURST = "burst"
}

data FireworksPredicate {
    var explosions: FireworkExplosions
    var flightDuration: (int | IntRange)?
}

data FireworkExplosions {
    var contains: list<FireworkExplosionPredicate>
    var size: (int | IntRange)?
    var count: list<FireworkExplosionCountPredicate>?
}

data FireworkExplosionCountPredicate {
    var test: FireworkExplosionPredicate
    var count: (int | IntRange)
}

data JukeboxPlayablePredicate: ItemSubPredicate {
    var songs: (string | list<string>)
}

data StoredEnchantments: ItemSubPredicate {
    var enchantments: (string | list<string>)
    var levels: (int | IntRange)
}

data TrimPredicate: ItemSubPredicate {
    var material: (string | list<string>)
    var pattern: (string | list<string>)
}

data WriteableBookContentPredicate: ItemSubPredicate {
    var pages: PagePredicate
}

data WrittenBookContentPredicate: ItemSubPredicate {
    var pages: PagePredicate
    var author: string
    var title: string
    var generation: (int | IntRange)
    var resolved: bool
}

data PagePredicate {
    var contains: list<text>?
    var size: (int | IntRange)?
    var count: list<PageCountPredicate>?
}

data PageCountPredicate {
    var test: text
    var count: (int | IntRange)
}
