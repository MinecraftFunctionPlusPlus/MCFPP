import mcfpp.math:*;

data ItemSubPredicate;

data AttributeModifierPredicate: ItemSubPredicate {
    modifiers as AttributeModifiers;
}

data AttributeModifiers {
    contains as list<AttributePredicate>?;
    size as (int | IntRange)?;
    count as list<AttributeCountPredicate>?;
}

data AttributeCountPredicate {
    test as AttributePredicate;
    count as (int | IntRange);
}

data AttributePredicate {
    attribute as (string | list<string>)?;
    id as list<string>?;
    amount as (float | DecimalRange)?;
    operation as AttributeOperation?;
    slot as AttributeSlot?;
}

enum AttributeOperation {
    ADD_VALUE = "add_value",
    ADD_MULTIPLIED_BASE = "add_multiplied_base",
    ADD_MULTIPLIED_TOTAL = "add_multiplied_total"
}

enum AttributeSlot {
    ANY = "any",
    MAINHAND = "mainhand",
    OFFHAND = "offhand",
    HAND = "hand",
    HEAD = "head",
    CHEST = "chest",
    LEGS = "legs",
    FEET = "feet",
    ARMOR = "armor"
}

data BundleContentsPredicate: ItemSubPredicate {
    items as ItemStackCompoundPredicate;
}

data ContainerPredicate: ItemSubPredicate {
    items as ItemStackCompoundPredicate;
}

data ItemStackCompoundPredicate {
    contains as list<ItemStackPredicate>;
    size as (int | IntRange)?;
    count as list<ItemStackCountPredicate>?;
}

data ItemStackPredicate {
    components as dict<ItemComponent>?;
    count as (int | IntRange)?;
    items as (string | list<string>)?;
    predicates as dict<nbt>?;
}

data ItemStackCountPredicate {
    test as ItemStackPredicate;
    count as (int | IntRange);
}

data CustomDataPredicate {}

data DamagePredicate: ItemSubPredicate {
    damage as (int | IntRange)?;
    durability as (int | IntRange)?;
}

data EnchantmentPredicate: ItemSubPredicate {
    enchantments as (string | list<string>);
    levels as (int | IntRange);
}

data FireworkExplosionPredicate: ItemSubPredicate {
    shape as FireworkShape?;
    hasTrail as bool?;
    hasTwinkle as bool?;
}

enum FireworkShape {
    SMALL_BALL = "small_ball",
    LARGE_BALL = "large_ball",
    STAR = "star",
    CREEPER = "creeper",
    BURST = "burst"
}

data FireworksPredicate {
    explosions as FireworkExplosions;
    flightDuration as (int | IntRange)?;
}

data FireworkExplosions {
    contains as list<FireworkExplosionPredicate>;
    size as (int | IntRange)?;
    count as list<FireworkExplosionCountPredicate>?;
}

data FireworkExplosionCountPredicate {
    test as FireworkExplosionPredicate;
    count as (int | IntRange);
}

data JukeboxPlayablePredicate: ItemSubPredicate {
    songs as (string | list<string>);
}

data StoredEnchantments: ItemSubPredicate {
    enchantments as (string | list<string>);
    levels as (int | IntRange);
}

data TrimPredicate: ItemSubPredicate {
    material as (string | list<string>);
    pattern as (string | list<string>);
}

data WriteableBookContentPredicate: ItemSubPredicate {
    pages as PagePredicate;
}

data WrittenBookContentPredicate: ItemSubPredicate {
    pages as PagePredicate;
    author as string;
    title as string;
    generation as (int | IntRange);
    resolved as bool;
}

data PagePredicate {
    contains as list<text>?;
    size as (int | IntRange)?;
    count as list<PageCountPredicate>?;
}

data PageCountPredicate {
    test as text;
    count as (int | IntRange);
}