import mcfpp.math:*;

data ItemSubPredicate;

data AttributeModifierPredicate: ItemSubPredicate {
    var modifiers as AttributeModifiers;
}

data AttributeModifiers {
    var contains as list<AttributePredicate>?;
    var size as (int | IntRange)?;
    var count as list<AttributeCountPredicate>?;
}

data AttributeCountPredicate {
    var test as AttributePredicate;
    var count as (int | IntRange);
}

data AttributePredicate {
    var attribute as (string | list<string>)?;
    var id as list<string>?;
    var amount as (float | DecimalRange)?;
    var operation as AttributeOperation?;
    var slot as AttributeSlot?;
}

enum AttributeOperation {
    ADD_VALUE = "add_value",
    ADD_MULTIPLIED_BASE = "add_multiplied_base",
    ADD_MULTIPLIED_TOTAL = "add_multiplied_total"
}

enum AttributeSlot {
    ANY = "any",
    MAINHAND = "mainhand",
    OFFHAND = "offhand",
    HAND = "hand",
    HEAD = "head",
    CHEST = "chest",
    LEGS = "legs",
    FEET = "feet",
    ARMOR = "armor"
}

data BundleContentsPredicate: ItemSubPredicate {
    var items as ItemStackCompoundPredicate;
}

data ContainerPredicate: ItemSubPredicate {
    var items as ItemStackCompoundPredicate;
}

data ItemStackCompoundPredicate {
    var contains as list<ItemStackPredicate>;
    var size as (int | IntRange)?;
    var count as list<ItemStackCountPredicate>?;
}

data ItemStackPredicate {
    var components as dict<ItemComponent>?;
    var count as (int | IntRange)?;
    var items as (string | list<string>)?;
    var predicates as dict<nbt>?;
}

data ItemStackCountPredicate {
    var test as ItemStackPredicate;
    var count as (int | IntRange);
}

data CustomDataPredicate {}

data DamagePredicate: ItemSubPredicate {
    var damage as (int | IntRange)?;
    var durability as (int | IntRange)?;
}

data EnchantmentPredicate: ItemSubPredicate {
    var enchantments as (string | list<string>);
    var levels as (int | IntRange);
}

data FireworkExplosionPredicate: ItemSubPredicate {
    var shape as FireworkShape?;
    var hasTrail as bool?;
    var hasTwinkle as bool?;
}

enum FireworkShape {
    SMALL_BALL = "small_ball",
    LARGE_BALL = "large_ball",
    STAR = "star",
    CREEPER = "creeper",
    BURST = "burst"
}

data FireworksPredicate {
    var explosions as FireworkExplosions;
    var flightDuration as (int | IntRange)?;
}

data FireworkExplosions {
    var contains as list<FireworkExplosionPredicate>;
    var size as (int | IntRange)?;
    var count as list<FireworkExplosionCountPredicate>?;
}

data FireworkExplosionCountPredicate {
    var test as FireworkExplosionPredicate;
    var count as (int | IntRange);
}

data JukeboxPlayablePredicate: ItemSubPredicate {
    var songs as (string | list<string>);
}

data StoredEnchantments: ItemSubPredicate {
    var enchantments as (string | list<string>);
    var levels as (int | IntRange);
}

data TrimPredicate: ItemSubPredicate {
    var material as (string | list<string>);
    var pattern as (string | list<string>);
}

data WriteableBookContentPredicate: ItemSubPredicate {
    var pages as PagePredicate;
}

data WrittenBookContentPredicate: ItemSubPredicate {
    var pages as PagePredicate;
    var author as string;
    var title as string;
    var generation as (int | IntRange);
    var resolved as bool;
}

data PagePredicate {
    var contains as list<text>?;
    var size as (int | IntRange)?;
    var count as list<PageCountPredicate>?;
}

data PageCountPredicate {
    var test as text;
    var count as (int | IntRange);
}
