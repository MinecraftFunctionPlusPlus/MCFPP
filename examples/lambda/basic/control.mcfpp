func apply(value: int, callback: (int) -> int): int { return callback(value); }
func consume(callback: () -> void) { callback(); }
func identity(value: int): int { return value; }
func genericApply<T>(value: T, callback: (T) -> T): T { return callback(value); }

func next(): int {
    import var value: int;
    /scoreboard players add lambda_order mcfpp_default 1
    /execute store result storage mcfpp:system stack_frame[0].value int 1 run scoreboard players get lambda_order mcfpp_default
    return value;
}

